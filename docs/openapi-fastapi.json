  "components": {
    "schemas": {
      "AdminCreateUserIn": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 64,
            "minLength": 3,
            "pattern": "^[A-Za-z0-9_.-]+$",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 72,
            "minLength": 8,
            "title": "Password"
          },
          "role": {
            "$ref": "#/components/schemas/Role",
            "default": "viewer"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "AdminCreateUserIn"
      },
      "ApplicationStatusIn": {
        "properties": {
          "application_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Application Id"
          },
          "candidate_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Candidate Id"
          },
          "vacancy_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Vacancy Id"
          },
          "status": {
            "type": "string",
            "maxLength": 16,
            "minLength": 1,
            "title": "Status"
          },
          "status_label": {
            "type": "string",
            "title": "Status Label",
            "default": ""
          },
          "vacancy_title": {
            "type": "string",
            "title": "Vacancy Title",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "application_id",
          "candidate_id",
          "vacancy_id",
          "status"
        ],
        "title": "ApplicationStatusIn",
        "description": "Подія від Django: змінився статус заявки."
      },
      "Body_token_auth_token_post": {
        "properties": {
          "grant_type": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^password$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Grant Type"
          },
          "username": {
            "type": "string",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "format": "password",
            "title": "Password"
          },
          "scope": {
            "type": "string",
            "title": "Scope",
            "default": ""
          },
          "client_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Client Id"
          },
          "client_secret": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "format": "password",
            "title": "Client Secret"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Body_token_auth_token_post"
      },
      "CandidateIn": {
        "properties": {
          "id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Id"
          },
          "full_name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Full Name"
          },
          "headline": {
            "type": "string",
            "title": "Headline",
            "default": ""
          },
          "city": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "City"
          },
          "expected_salary": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Salary"
          },
          "skills": {
            "items": {
              "$ref": "#/components/schemas/SkillLevel"
            },
            "type": "array",
            "title": "Skills",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "id",
          "full_name"
        ],
        "title": "CandidateIn"
      },
      "CandidateMatch": {
        "properties": {
          "candidate_id": {
            "type": "integer",
            "title": "Candidate Id"
          },
          "full_name": {
            "type": "string",
            "title": "Full Name"
          },
          "headline": {
            "type": "string",
            "title": "Headline",
            "default": ""
          },
          "city": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "City"
          },
          "score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Score"
          },
          "score_percent": {
            "type": "integer",
            "title": "Score Percent"
          },
          "matched": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Matched"
          },
          "missing": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Missing"
          }
        },
        "type": "object",
        "required": [
          "candidate_id",
          "full_name",
          "score",
          "score_percent",
          "matched",
          "missing"
        ],
        "title": "CandidateMatch"
      },
      "CandidatesResponse": {
        "properties": {
          "vacancy_id": {
            "type": "integer",
            "title": "Vacancy Id"
          },
          "metric": {
            "$ref": "#/components/schemas/Metric"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/CandidateMatch"
            },
            "type": "array",
            "title": "Results"
          }
        },
        "type": "object",
        "required": [
          "vacancy_id",
          "metric",
          "results"
        ],
        "title": "CandidatesResponse"
      },
      "ExplainResponse": {
        "properties": {
          "vacancy_id": {
            "type": "integer",
            "title": "Vacancy Id"
          },
          "candidate_id": {
            "type": "integer",
            "title": "Candidate Id"
          },
          "jaccard": {
            "type": "number",
