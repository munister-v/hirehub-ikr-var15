    "/match/vacancy/{vacancy_id}/candidates": {
      "get": {
        "tags": [
          "match"
        ],
        "summary": "Candidates For Vacancy",
        "description": "Топ кандидатів для вакансії за коефіцієнтом Жаккара або косинусною подібністю.",
        "operationId": "candidates_for_vacancy_match_vacancy__vacancy_id__candidates_get",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "vacancy_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Vacancy Id"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 10,
              "title": "Limit"
            }
          },
          {
            "name": "metric",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Metric",
              "default": "jaccard"
            }
          },
          {
            "name": "min_score",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 1,
              "minimum": 0,
              "default": 0.0,
              "title": "Min Score"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CandidatesResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
