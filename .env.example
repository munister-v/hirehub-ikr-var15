# Скопіюйте у .env і змініть значення. Файл .env у репозиторій НЕ потрапляє.

# --- спільне ---
# спільний секрет для JWT між Django і FastAPI (HS256); у продакшні — довгий випадковий рядок
SHARED_JWT_SECRET=change-me-shared-jwt-secret-at-least-32-chars

# --- PostgreSQL (docker compose створює обидві бази) ---
POSTGRES_USER=hirehub
POSTGRES_PASSWORD=change-me-postgres
DJANGO_DB=hirehub_django
FASTAPI_DB=hirehub_matching

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=change-me-django-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me-admin-password
DJANGO_SUPERUSER_EMAIL=admin@example.com
SEED_DEMO_DATA=true

# --- FastAPI (Matching Service) ---
MATCHING_ADMIN_USERNAME=admin
MATCHING_ADMIN_PASSWORD=change-me-matching-admin
MATCHING_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
